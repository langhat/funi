test = {
	assert_eq: expected -> actual ->
		__out("PASS") if expected == actual else __out("FAIL: expected " + expected as Str + " but got " + actual as Str),
	assert_neq: expected -> actual ->
		__out("PASS") if expected != actual else __out("FAIL: values should differ"),
	assert_true: condition ->
		__out("PASS") if condition else __out("FAIL: expected true"),
	assert_false: condition ->
		__out("PASS") if condition == false else __out("FAIL: expected false"),
	assert_lt: a -> b ->
		__out("PASS") if a < b else __out("FAIL: expected " + a as Str + " < " + b as Str),
	assert_gt: a -> b ->
		__out("PASS") if a > b else __out("FAIL: expected " + a as Str + " > " + b as Str),
	assert_lte: a -> b ->
		__out("PASS") if a <= b else __out("FAIL: expected " + a as Str + " <= " + b as Str),
	assert_gte: a -> b ->
		__out("PASS") if a >= b else __out("FAIL: expected " + a as Str + " >= " + b as Str)
}
