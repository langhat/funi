math = {
    pi: 3.141592653589793,
    e: 2.718281828459045,
    nan: @get_nan(),
    inf: @get_inf(),
    add: a -> b -> a + b,
    sub: a -> b -> a - b,
    mul: a -> b -> a * b,
    div: a -> b -> a / b,
    mod: a -> b -> a % b,
    min: a -> b -> (a if (a < b) else b),
    max: a -> b -> (a if (a > b) else b),
    abs: x -> ((0 - x) if (x < 0) else x),
    sign: x -> (1 if (x > 0) else ((0 - 1) if (x < 0) else 0)),
    neg: x -> (0 - x),
    pow: base -> exp -> @pow(base as Real, exp as Real),
    sqrt: k -> @pow(k as Real, 0.5),
    if_nan: k -> @if_nan(k ..Real),
    if_inf: k -> @if_inf(k ..Real),
    log: k -> @log(k as Real),
    sin: k -> @sin(k as Real),
    cos: k -> @cos(k as Real),
    tan: k -> @tan(k as Real),
    asin: k -> @asin(k as Real),
    acos: k -> @acos(k as Real),
    atan: k -> @atan(k as Real)
}